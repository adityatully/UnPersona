+# [unpersona] How a 0_100 score is read from the judge:
+#   logprob (default, = paper): 1 output token, score = sum_n n * p(n) over number tokens 0..100
+#                               in the top-20 logprobs. Only valid if "0".."100" are single tokens.
+#   text:                       greedy, up to 4 tokens, parse the number in the text. For judges whose
+#                               tokenizer splits numbers into digits (Qwen: "85" -> "8","5").
+JUDGE_SCORING = os.environ.get("JUDGE_SCORING", "logprob")
+assert JUDGE_SCORING in ("logprob", "text"), f"JUDGE_SCORING must be logprob or text, got {JUDGE_SCORING}"
+_checked_models = set()
 
 
+def _check_numbers_are_single_tokens(model: str) -> None:
+    """[unpersona] Fail loudly if logprob scoring is used with a judge that splits numbers into digits.
+    Uses the /tokenize endpoint of the local vLLM server (skipped when no OPENAI_BASE_URL is set)."""
+    base_url = os.environ.get("OPENAI_BASE_URL")
+    if JUDGE_SCORING != "logprob" or not base_url or model in _checked_models:
+        return
+    import httpx
+    root = base_url.rstrip("/").removesuffix("/v1")
+    for s in ["85", "100"]:
+        r = httpx.post(f"{root}/tokenize", json={"model": model, "prompt": s, "add_special_tokens": False}, timeout=30)
+        r.raise_for_status()
+        n = r.json()["count"]
+        if n != 1:
+            raise RuntimeError(f"Judge {model} tokenizes {s!r} into {n} tokens: logprob scoring would read only "
+                               f"the first digit. Set JUDGE_SCORING=text for this judge.")
+    _checked_models.add(model)
+
+
